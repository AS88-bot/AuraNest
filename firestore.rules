
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isEmergencyContact(userId) {
      // Allow if the requesting user is in the target user's list of emergency contacts.
      return isSignedIn() && get(/databases/$(database)/documents/users/$(userId)).data.emergencyContactIds.hasAny([request.auth.uid]);
    }
    
    function isAuthorizedForLocation(userId) {
        // This checks the denormalized list of IDs on the location document itself.
        let locationData = get(/databases/$(database)/documents/users/$(userId)/emergencyLocation/latest).data;
        return isSignedIn() && locationData.emergencyContactIds.hasAny([request.auth.uid]);
    }

    match /users/{userId} {
      // A user can read their own profile, and their emergency contacts can also read it.
      allow get: if isOwner(userId) || isEmergencyContact(userId);
      // Only the user can write to their own profile.
      allow write: if isOwner(userId);

      match /caregivers/{caregiverId} {
        allow read, write: if isOwner(userId);
      }
      match /dailyTasks/{dailyTaskId} {
        allow read, write: if isOwner(userId);
      }
      match /medications/{medicationId} {
        allow read, write: if isOwner(userId);
      }
      match /memoryJournalEntries/{memoryJournalEntryId} {
        allow read, write: if isOwner(userId);
      }
      match /safeZones/{safeZoneId} {
        allow read, write: if isOwner(userId);
      }
      match /emergencyContacts/{emergencyContactId} {
        // User can manage their own contacts. An emergency contact can read their own entry.
        allow read, write: if isOwner(userId);
      }
      match /moodEntries/{moodEntryId} {
        allow read, write: if isOwner(userId);
      }
      
      match /emergencyLocation/{locationId} {
        // Only the user can create or update their location.
        allow create, update: if isOwner(userId);
        // For development: Allow any signed-in user to read location data.
        // In production, this should be: isOwner(userId) || isAuthorizedForLocation(userId);
        allow get: if isSignedIn();
        allow list: if isOwner(userId);
      }
    }
  }
}
    