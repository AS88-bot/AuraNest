{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user of the AuraNest application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the User entity."
        },
        "name": {
          "type": "string",
          "description": "The user's full name."
        },
        "dateOfBirth": {
          "type": "string",
          "description": "The user's date of birth.",
          "format": "date-time"
        },
        "profilePicture": {
          "type": "string",
          "description": "URL to the user's profile picture.",
          "format": "uri"
        },
        "emergencyContactIds": {
          "type": "array",
          "description": "References to Emergency Contacts who are also users.",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "name"
      ]
    },
    "Caregiver": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Caregiver",
      "type": "object",
      "description": "Represents a caregiver associated with a user.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Caregiver entity."
        },
        "name": {
          "type": "string",
          "description": "The caregiver's full name."
        },
        "phoneNumber": {
          "type": "string",
          "description": "The caregiver's phone number."
        },
        "email": {
          "type": "string",
          "description": "The caregiver's email address.",
          "format": "email"
        },
        "userId": {
          "type": "string",
          "description": "Reference to User. (Relationship: User 1:N Caregiver)"
        }
      },
      "required": [
        "id",
        "name",
        "phoneNumber",
        "userId"
      ]
    },
    "DailyTask": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "DailyTask",
      "type": "object",
      "description": "Represents a daily task or activity for the user.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the DailyTask entity."
        },
        "userId": {
          "type": "string",
          "description": "Reference to User. (Relationship: User 1:N DailyTask)"
        },
        "title": {
          "type": "string",
          "description": "Title of the task."
        },
        "description": {
          "type": "string",
          "description": "Detailed description of the task."
        },
        "scheduledTime": {
          "type": "string",
          "description": "Scheduled time for the task.",
          "format": "date-time"
        },
        "isCompleted": {
          "type": "boolean",
          "description": "Indicates if the task is completed."
        },
        "icon": {
          "type": "string",
          "description": "The icon that represents the task."
        },
        "color": {
          "type": "string",
          "description": "The color associated with the task."
        }
      },
      "required": [
        "id",
        "userId",
        "title",
        "scheduledTime"
      ]
    },
    "Medication": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Medication",
      "type": "object",
      "description": "Represents a medication for the user.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Medication entity."
        },
        "userId": {
          "type": "string",
          "description": "Reference to User. (Relationship: User 1:N Medication)"
        },
        "name": {
          "type": "string",
          "description": "Name of the medication."
        },
        "dosage": {
          "type": "string",
          "description": "Dosage of the medication."
        },
        "time": {
          "type": "string",
          "description": "Time to take the medication.",
          "format": "date-time"
        },
        "image": {
          "type": "string",
          "description": "Image URL of the medication pill or bottle.",
          "format": "uri"
        }
      },
      "required": [
        "id",
        "userId",
        "name",
        "dosage",
        "time"
      ]
    },
    "MemoryJournalEntry": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "MemoryJournalEntry",
      "type": "object",
      "description": "Represents a memory journal entry.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the MemoryJournalEntry entity."
        },
        "userId": {
          "type": "string",
          "description": "Reference to User. (Relationship: User 1:N MemoryJournalEntry)"
        },
        "date": {
          "type": "string",
          "description": "Date of the journal entry.",
          "format": "date-time"
        },
        "text": {
          "type": "string",
          "description": "Text content of the journal entry."
        },
        "photoUrl": {
          "type": "string",
          "description": "URL of the associated photo.",
          "format": "uri"
        },
        "voiceNoteUrl": {
          "type": "string",
          "description": "URL of the voice note recording.",
          "format": "uri"
        }
      },
      "required": [
        "id",
        "userId",
        "date"
      ]
    },
    "Location": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Location",
      "type": "object",
      "description": "Represents the location of the user.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Location entity."
        },
        "userId": {
          "type": "string",
          "description": "Reference to User. (Relationship: User 1:1 Location)"
        },
        "latitude": {
          "type": "number",
          "description": "The latitude of the user."
        },
        "longitude": {
          "type": "number",
          "description": "The longitude of the user."
        },
        "timestamp": {
          "type": "string",
          "description": "The time the location was recorded.",
          "format": "date-time"
        },
        "emergencyContactIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "A list of emergency contact UIDs who are authorized to view this location data."
        }
      },
      "required": [
        "id",
        "userId",
        "latitude",
        "longitude",
        "timestamp"
      ]
    },
    "SafeZone": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "SafeZone",
      "type": "object",
      "description": "Represents a safe zone for the user.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the SafeZone entity."
        },
        "userId": {
          "type": "string",
          "description": "Reference to User. (Relationship: User 1:N SafeZone)"
        },
        "name": {
          "type": "string",
          "description": "The name of the safe zone."
        },
        "latitude": {
          "type": "number",
          "description": "The latitude of the safe zone."
        },
        "longitude": {
          "type": "number",
          "description": "The longitude of the safe zone."
        },
        "radius": {
          "type": "number",
          "description": "The radius of the safe zone in meters."
        }
      },
      "required": [
        "id",
        "userId",
        "name",
        "latitude",
        "longitude",
        "radius"
      ]
    },
    "EmergencyContact": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "EmergencyContact",
      "type": "object",
      "description": "Represents an emergency contact for the user.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the EmergencyContact entity. Should be the user's UID if they are an app user."
        },
        "userId": {
          "type": "string",
          "description": "Reference to User. (Relationship: User 1:N EmergencyContact)"
        },
        "name": {
          "type": "string",
          "description": "The name of the emergency contact."
        },
        "phoneNumber": {
          "type": "string",
          "description": "The phone number of the emergency contact."
        }
      },
      "required": [
        "id",
        "userId",
        "name",
        "phoneNumber"
      ]
    },
    "MoodEntry": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "MoodEntry",
      "type": "object",
      "description": "Represents a mood entry recorded by the user.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the MoodEntry entity."
        },
        "userId": {
          "type": "string",
          "description": "Reference to User. (Relationship: User 1:N MoodEntry)"
        },
        "date": {
          "type": "string",
          "description": "Date of the mood entry.",
          "format": "date-time"
        },
        "mood": {
          "type": "string",
          "description": "The mood expressed (e.g., happy, sad, angry)."
        },
        "emoji": {
          "type": "string",
          "description": "The emoji representing the mood."
        },
        "notes": {
          "type": "string",
          "description": "Additional notes about the mood."
        }
      },
      "required": [
        "id",
        "userId",
        "date",
        "mood"
      ]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/backend/entities/User"
      },
      "description": "Stores user profile information. Path-based ownership enforced."
    },
    "/users/{userId}/caregivers/{caregiverId}": {
      "schema": {
        "$ref": "#/backend/entities/Caregiver"
      },
      "description": "Stores caregiver information for a specific user. Path-based ownership enforced."
    },
    "/users/{userId}/dailyTasks/{dailyTaskId}": {
      "schema": {
        "$ref": "#/backend/entities/DailyTask"
      },
      "description": "Stores daily tasks for a specific user. Path-based ownership enforced."
    },
    "/users/{userId}/medications/{medicationId}": {
      "schema": {
        "$ref": "#/backend/entities/Medication"
      },
      "description": "Stores medication information for a specific user. Path-based ownership enforced."
    },
    "/users/{userId}/memoryJournalEntries/{memoryJournalEntryId}": {
      "schema": {
        "$ref": "#/backend/entities/MemoryJournalEntry"
      },
      "description": "Stores memory journal entries for a specific user. Path-based ownership enforced."
    },
    "/users/{userId}/safeZones/{safeZoneId}": {
      "schema": {
        "$ref": "#/backend/entities/SafeZone"
      },
      "description": "Stores safe zone information for a specific user. Path-based ownership enforced."
    },
    "/users/{userId}/emergencyContacts/{emergencyContactId}": {
      "schema": {
        "$ref": "#/backend/entities/EmergencyContact"
      },
      "description": "Stores emergency contact information for a specific user. Path-based ownership enforced."
    },
    "/users/{userId}/moodEntries/{moodEntryId}": {
      "schema": {
        "$ref": "#/backend/entities/MoodEntry"
      },
      "description": "Stores mood entries for a specific user. Path-based ownership enforced."
    },
    "/users/{userId}/emergencyLocation/{locationId}": {
      "schema": {
        "$ref": "#/backend/entities/Location"
      },
      "description": "Stores the user's location data for emergency access by authorized contacts. Includes a denormalized 'emergencyContactIds' array for authorization."
    }
  }
}
